      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(jobqueue_job_enqueue_to_start_seconds_bucket[1m])))",
          "legendFormat": "p50",
          "refId": "A",
          "editorMode": "code",
          "range": true
