        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(jobqueue_job_enqueue_to_start_seconds_bucket[1m])))",
          "legendFormat": "p99",
          "refId": "C",
          "editorMode": "code",
          "range": true
